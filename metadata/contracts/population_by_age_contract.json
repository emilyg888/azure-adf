{
  "dataset_id": "DS_REF_POPULATION_001",
  "dataset_name": "population_by_age",
  "contract_version": "0.1",
  "inputs": [
    {
      "name": "raw_population",
      "role": "primary",
      "format": "csv",
      "delimiter": "tab",
      "path": "/raw/population/population_by_age.tsv"
    }
  ],
  "lookups": [
    {
      "name": "dim_country",
      "format": "csv",
      "delimiter": "comma",
      "path": "/lookup/dim_country.csv",
      "join_key": {
        "source": "country_code",
        "lookup": "country_code_2_digit"
      }
    }
  ],
  "target": {
    "platform": "file",
    "storage_type": "file",
    "format": "csv",
    "schema": "silver",
    "object": "population_by_age",
    "path": "/processed/population_by_age/population_by_age.csv",
    "write_mode": "overwrite",
    "write_strategy": "full_load"
  },
  "expected_columns": [
    "country",
    "country_code_2_digit",
    "country_code_3_digit",
    "population",
    "age_group_0_14",
    "age_group_15_24",
    "age_group_25_49",
    "age_group_50_64",
    "age_group_65_79",
    "age_group_80_max"
  ]
}
